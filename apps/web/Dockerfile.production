# Production proxy image (TASK-058, deployment.md): Caddy with the PWA build and Django's static files.
# It terminates HTTPS, serves the app, and passes /api/ (WebSockets included) and /health/ to the API
# (/admin is the app's own back office). Build context is the repository root; the "api" context is the API production image, from which it
# takes the collected static files (compose wires it up; with plain buildx pass
# --build-context api=docker-image://<api image>). The development image is ./Dockerfile.

FROM node:22-alpine AS build
RUN npm install -g pnpm@10
WORKDIR /app/apps/web
COPY apps/web/package.json apps/web/pnpm-lock.yaml apps/web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY packages /app/packages
COPY apps/web ./
# Public build-time values (deployment.md): leave VITE_API_BASE_URL empty when this proxy serves the app and
# the API on one origin, the default. APP_BUILD is the release number CI sets; empty means the build time.
ARG VITE_API_BASE_URL=""
ARG APP_BUILD=""
RUN VITE_API_BASE_URL="$VITE_API_BASE_URL" APP_BUILD="$APP_BUILD" pnpm build

FROM caddy:2-alpine
COPY infra/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv/app
COPY --from=api /app/staticfiles /srv/static
