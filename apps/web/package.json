{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:deck": "node --experimental-strip-types --test test/deck.test.ts",
    "typecheck:deck": "tsc -p tsconfig.test.json",
    "test:scoring": "node --experimental-strip-types --test ../../packages/scoring/test/scoring.test.ts",
    "typecheck:scoring": "tsc -p ../../packages/scoring",
    "gen:parity": "node --experimental-strip-types ../../packages/scoring/scripts/make-parity.ts",
    "gen:api": "openapi-typescript ../../services/api/openapi.yaml -o ../../packages/contracts/api-schema.d.ts",
    "test:e2e": "playwright test",
    "test:offline": "node --experimental-strip-types --test test/offline.test.ts",
    "test:live": "node --experimental-strip-types --test test/live.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@tansuasici/country-state-city": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "6.2.8",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.79.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
