# Copy to .env for local development: cp .env.example .env
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-for-anything-shared
DATABASE_URL=postgres://mombasa:mombasa-dev-only@127.0.0.1:5433/mombasa_tt
FRONTEND_URL=http://localhost:5173
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# DEV_LOGIN_PASSWORD=mombasa-tt-dev
# SMTP_HOST= (unset = emails print to the runserver console)
# ATTACHMENTS_ROOT=var/attachments (private uploads; never served directly)
# ATTACHMENT_URL_TTL=300 (seconds a signed attachment link stays valid)
# THROTTLE_UPLOADS=30/hour (profile photo uploads per player)
# REDIS_URL=redis://127.0.0.1:6380/0 (required when DJANGO_DEBUG is off: rate limits are counted there.
#   Unset = run `manage.py work_outbox`; set = run Celery:
#   `celery -A config worker -l INFO` and one `celery -A config beat -l INFO`)
# LOG_FORMAT=text (json = one JSON object per line; the default when DJANGO_DEBUG is off)

# Oldest web app build (APP_BUILD, YYYYMMDDHHMM) the API serves; 0 serves all (REQ-035).
MIN_CLIENT_BUILD=0
# Browser push (TASK-034): empty = off. `uv run manage.py push_keys` prints a key. Push only reaches a
# production build (the service worker doesn't run under the Vite dev server).
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:you@example.com
# Soda game stakes (REQ-040): leave off until the legal and policy sign-off is recorded (TASK-078).
SODA_STAKES_ENABLED=false
# The platform owner (a super admin), made when the compose stack's API starts; they log in to the app and
# open /admin, the back office.
# The password needs 10 characters or more and is only used to create the account. Unset = no account.
# OWNER_EMAIL=you@example.com
# OWNER_PASSWORD=
# OWNER_NAME=
