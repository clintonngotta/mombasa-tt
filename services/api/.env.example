# Copy to .env for local development: cp .env.example .env
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-for-anything-shared
DATABASE_URL=postgres://mombasa:mombasa-dev-only@127.0.0.1:5433/mombasa_tt
FRONTEND_URL=http://localhost:5173
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# DEV_LOGIN_PASSWORD=mombasa-tt-dev
# SMTP_HOST= (unset = emails print to the runserver console)
# ATTACHMENTS_ROOT=var/attachments (private uploads; never served directly)
# ATTACHMENT_URL_TTL=300 (seconds a signed attachment link stays valid)
# THROTTLE_UPLOADS=30/hour (profile photo uploads per player)
