      "expect": {
        "server": "a1",
        "receiver": "b1"
      }
    },
    {
      "points": "aa",
      "expect": {
        "server": "b1",
        "receiver": "a2"
      }
    },
    {
      "points": "aa",
      "expect": {
        "server": "a2",
        "receiver": "b2"
      }
    },
    {
      "points": "aa",
      "expect": {
        "server": "b2",
        "receiver": "a1"
      }
    },
    {
      "points": "aa",
      "expect": {
        "server": "a1",
        "receiver": "b1",
        "points": [
          8,
          0
        ]
      }
    },
    {
      "points": "aa",
      "expect": {
        "server": "b1",
        "receiver": "a2",
        "points": [
          10,
          0
        ]
      }
    },
    {
      "points": "a",
