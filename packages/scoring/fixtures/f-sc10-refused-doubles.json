{
  "name": "F-SC10b: a doubles match needs a receiver from the other pair; the first game's server is fixed at the start",
  "rules": "2.13.4",
  "config": {
    "best_of": 3,
    "doubles": true
  },
  "steps": [
    {
      "event": {
        "type": "start",
        "server": "a1",
        "a_end": "left"
      },
      "error": "invalid_start"
    },
    {
      "event": {
        "type": "start",
        "server": "a1",
        "a_end": "left",
        "receiver": "a2"
      },
      "error": "invalid_start"
    },
    {
      "event": {
        "type": "choose_server",
        "player": "a1"
      },
      "error": "not_in_progress"
    },
    {
      "event": {
        "type": "start",
        "server": "b2",
        "a_end": "right",
        "receiver": "a2"
      },
      "expect": {
        "server": "b2",
        "receiver": "a2",
        "a_end": "right"
      }
    },
    {
      "event": {
        "type": "choose_server",
        "player": "b1"
      },
      "error": "game_under_way"
    }
  ]
}
