{
  "name": "F-SC7a: in the deciding game the players change ends once, when a side first has 5",
  "rules": "2.13.6, 2.13.7",
  "config": {
    "best_of": 3,
    "doubles": false
  },
  "steps": [
    {
      "event": {
        "type": "start",
        "server": "a1",
        "a_end": "left"
      }
    },
    {
      "points": "aaaaaaaaaaa",
      "expect": {
        "game_number": 2,
        "server": "b1",
        "a_end": "right"
      }
    },
    {
      "points": "bbbbbbbbbbb",
      "expect": {
        "game_number": 3,
        "games_won": [
          1,
          1
        ],
        "server": "a1",
        "receiver": "b1",
        "a_end": "left",
        "decider_changed": false
      }
    },
    {
      "points": "aaaa",
      "expect": {
        "points": [
          4,
          0
        ],
        "a_end": "left",
        "decider_changed": false
      }
    },
    {
      "points": "a",
      "expect": {
        "points": [
          5,
          0
        ],
        "a_end": "right",
        "decider_changed": true,
        "server": "a1"
      }
    },
    {
      "points": "bbbbb",
      "expect": {
        "points": [
          5,
          5
        ],
        "a_end": "right",
        "decider_changed": true
      }
    }
  ]
}
