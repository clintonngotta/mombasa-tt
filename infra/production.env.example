# Copy to /srv/mombasa-tt/.env.production (chmod 600, deployment account only) and fill in. No secrets in
# this file or in source control. Contract and rules: deployment.md, "Domains and configuration contract".

# The site's hostname. Caddy gets its certificate; Django allows it and trusts https://APP_DOMAIN for CSRF.
APP_DOMAIN=app.example.com
# Optional overrides of what APP_DOMAIN implies (comma-separated, exact, no wildcards).
# DJANGO_ALLOWED_HOSTS=app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# FRONTEND_URL=https://app.example.com

# Released images (immutable tags or digests). Keep the previous pair in the release history for rollback.
APP_IMAGE=
WEB_IMAGE=

# Unique per environment. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Transactional email (verification, password reset, invitations). Unset prints emails to the api log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=Coast TT <no-reply@example.com>

# Optional.
# WORKER_CONCURRENCY=2
# ATTACHMENT_URL_TTL=300
# MIN_CLIENT_BUILD=0
# LOG_LEVEL=INFO
# Leave off until the legal and policy sign-off is recorded (TASK-078).
SODA_STAKES_ENABLED=false
# HTTP_PORT=80
# HTTPS_PORT=443
# Staging on the same host needs its own project name, ports and env file.
# COMPOSE_PROJECT_NAME=mombasa-tt-staging
